#!/usr/bin/python3 -I
"""Bridge monthly image alerts to the existing host notifier without sharing secrets."""

import json
import subprocess


def main():
    process = None
    try:
        process = subprocess.Popen(
            [
                "/usr/bin/docker",
                "compose",
                "-f",
                "/srv/homelab/homelab-v2/compose.yaml",
                "exec",
                "-T",
                "api",
                "python",
                "-m",
                "homelab.api.image_costs",
                "alerts",
            ],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
        )
        for line in process.stdout:
            event = json.loads(line)
            if event.get("done") is True:
                return int(process.wait(timeout=5) != 0)
            message = event["message"]
            if not isinstance(message, str) or len(message) > 1000:
                raise ValueError("Invalid budget notice")
            subprocess.run(
                ["/usr/local/sbin/homelab-notify.sh", message],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=65,
                check=True,
            )
            process.stdin.write("sent\n")
            process.stdin.flush()
        return 1
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        return 1
    finally:
        if process is not None and process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait()


if __name__ == "__main__":
    raise SystemExit(main())
