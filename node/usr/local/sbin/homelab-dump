#!/usr/bin/env python3
"""Create durable daily custom-format dumps of all non-template databases."""

import datetime
import fcntl
import glob
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

DIRECTORY = Path("/srv/homelab/homelab-v2-data/originals/postgres")
FAILURE = "homelab-dump: failed"


def dump():
    with (DIRECTORY / ".lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        date = datetime.date.today().isoformat()
        for database in databases():
            dump_database(database, date)


def databases():
    result = subprocess.run(
        [
            "docker",
            "exec",
            "homelab-postgres-1",
            "psql",
            "-X",
            "-qAt",
            "-v",
            "ON_ERROR_STOP=1",
            "-U",
            "homelab",
            "-d",
            "homelab",
            "-c",
            "SELECT json_agg(datname ORDER BY datname) FROM pg_database WHERE NOT datistemplate",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=True,
    )
    names = json.loads(result.stdout)
    if (
        type(names) is not list
        or not names
        or any(type(name) is not str or not name or "/" in name or "\x00" in name for name in names)
    ):
        raise ValueError()
    return names


def dump_database(database, date):
    name = database + "-" + date + ".dump"
    fd, temporary = tempfile.mkstemp(prefix=".dump-", dir=DIRECTORY)
    try:
        with os.fdopen(fd, "wb") as output:
            os.fchmod(output.fileno(), 0o640)
            subprocess.run(
                [
                    "docker",
                    "exec",
                    "homelab-postgres-1",
                    "pg_dump",
                    "-U",
                    "homelab",
                    "-Fc",
                    "--dbname",
                    "dbname='" + database.replace("\\", "\\\\").replace("'", "\\'") + "'",
                ],
                stdout=output,
                stderr=subprocess.DEVNULL,
                check=True,
            )
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, DIRECTORY / name)
        directory_fd = os.open(DIRECTORY, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
        for old in sorted(DIRECTORY.glob(glob.escape(database) + "-????-??-??.dump"), reverse=True)[
            7:
        ]:
            old.unlink()
    finally:
        Path(temporary).unlink(missing_ok=True)


def main():
    try:
        dump()
    except (OSError, ValueError, subprocess.SubprocessError):
        print(FAILURE, file=sys.stderr)
        return 1
    print("ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
