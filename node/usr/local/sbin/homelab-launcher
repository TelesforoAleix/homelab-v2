        "optional": {"read_only": False, "stdin": False},
    },
    "chat": {
        "network": "homelab-fence",
        "mounts": {
            "login": "/login:rw",
            "work": "/work:rw",
            "run": "/run/factory:rw",
            "exports": "/work/repos/<id>:ro",
        },
        "timeout": 1200,
