    "bundle": {
        "network": "none",
        "mounts": {"work": "/work:ro", "run": "/run/factory:rw"},
        "timeout": None,
        "optional": {"stream": False},
    },
    "usage": {"network": "none", "mounts": {"codex-login": "/login:ro"}, "timeout": None},
}

TASK_WORK_ROOT = Path("/srv/homelab/task-work")
TASK_IMAGE = "homelab-task:3"
TASK_STRING_LIMIT = 32768
TASK_ARGUMENT_LIMIT = 256
TASK_DATA_LIMIT = 48 * 1024
TASK_MODEL_ENV = [
    "HOMELAB_TASK_TOKEN",
    "HOMELAB_TASK_PURPOSE",
    "HOMELAB_PI_MODELS",
    "HOMELAB_PI_SETTINGS",
]
