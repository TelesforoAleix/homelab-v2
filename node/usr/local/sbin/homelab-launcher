TASK_SHAPES["clone"] = {
    "network": "homelab-fence",
    "mounts": {"work": "/work:rw"},
    "stdin": False,
    "environment": [
        "HTTPS_PROXY=http://cli-proxy:8888",
        "HTTP_PROXY=http://cli-proxy:8888",
        "GIT_CONFIG_NOSYSTEM=1",
        "GIT_CONFIG_GLOBAL=/dev/null",
        "GIT_TERMINAL_PROMPT=0",
    ],
    "optional_environment": [
        "GIT_CONFIG_COUNT=1",
        "GIT_CONFIG_KEY_0=http.https://github.com/.extraHeader",
        "GIT_CONFIG_VALUE_0",
    ],
    "entrypoint": "/usr/bin/git",
    "entry": [],
}
TASK_SHAPES["data"] = {
    "network": "none",
    "mounts": {"work": "/work:rw"},
    "stdin": True,
    "environment": [],
    "entrypoint": "/usr/bin/python3",
    "entry": ["-I", "-c"],
}
REPOSITORY = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*/[A-Za-z0-9][A-Za-z0-9._-]*\Z")
CLI_WORK = re.compile(r"(?:ticket-[0-9]+-[0-9]+|run-[0-9a-f]{32})\Z")


def branch_name(value):
    # git-check-ref-format --branch rules, without invoking anything supplied by the caller.
    if (
        type(value) is not str
        or not value
        or value.startswith("-")
        or value in {"@", "HEAD"}
        or any(ord(c) < 33 or ord(c) == 127 or c in "~^:?*[\\" for c in value)
        or ".." in value
        or "@{" in value
        or any(
            not part or part.startswith(".") or part.endswith((".", ".lock"))
            for part in value.split("/")
        )
    ):
        raise Refused("invalid_branch")
    return value


def clone_arguments(request):
    fields(
        request,
        ("op", "profile", "run_id", "work_id", "shape", "repository", "branch"),
        ("env", "workspace"),
    )
    repository = request["repository"]
    if type(repository) is not str or not REPOSITORY.fullmatch(repository) or ".." in repository:
        raise Refused("invalid_repository")
    branch = branch_name(request["branch"])
    return [
        "-c",
        "core.hooksPath=/dev/null",
        "-c",
        "credential.helper=",
        *(["-c", "http.followRedirects=false"] if "env" in request else []),
        "clone",
        *(["--no-hardlinks"] if request.get("workspace") == "cli" else []),
        "--template=",
        "--no-tags",
        "--single-branch",
        "--branch",
        branch,
        "--",
        f"https://github.com/{repository}.git",
        "/work",
    ]


TASK_PROFILE = {
    "image": TASK_IMAGE,
    "limits": {"memory": "8g", "memory_swap": "8g", "cpus": "2", "pids": 512},
    "user": "work-owner (non-root)",
    "tmpfs": [
        "/tmp:rw,exec,nosuid,nodev,size=4g,mode=1777",
        "/home/task:rw,exec,nosuid,nodev,size=4g,uid=<uid>,gid=<gid>,mode=0700",
    ],
    "shapes": TASK_SHAPES,
    "timeout": None,
}

# Executed only inside the fence image. No host read of login file contents.
USAGE_SCRIPT = """import json
from pathlib import Path
result = None
try:
    paths = sorted((p for p in Path('/login/sessions').rglob('*.jsonl')
                    if not p.is_symlink() and p.is_file()),
                   key=lambda p: (p.stat().st_mtime_ns, str(p)), reverse=True)
    for path in paths:
        candidate = None
        try:
            with path.open() as stream:
                for line in stream:
                    try:
                        value = json.loads(line).get('payload', {}).get('rate_limits')
                        if isinstance(value, dict) and any(
                            isinstance(value.get(k), dict) for k in ('primary', 'secondary')):
                            candidate = value
                    except (ValueError, AttributeError, TypeError, RecursionError):
                        pass
        except (OSError, UnicodeError):
            continue
        if candidate is not None:
            result = candidate
            break
except OSError:
    pass
print(json.dumps(result, separators=(',', ':')))
"""
USAGE_COMMAND = ["python3", "-I", "-c", USAGE_SCRIPT]


class Refused(Exception):
    """Only fixed reason strings may leave the helper."""


def identifier(value):
    if not isinstance(value, str) or not IDENTIFIER.fullmatch(value):
        raise Refused("invalid_identifier")
    return value


def fields(value, required, optional=()):
    if (
        type(value) is not dict
        or not set(required) <= value.keys()
        or (value.keys() - set(required) - set(optional))
    ):
        raise Refused("invalid_fields")


def decode_json(data):
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                raise Refused("invalid_json")
            result[key] = value
        return result

    try:
        if isinstance(data, (bytes, bytearray)):
            data = data.decode("utf-8")
        return json.loads(
            data,
            object_pairs_hook=pairs,
            parse_constant=lambda _: (_ for _ in ()).throw(Refused("invalid_json")),
        )
    except (ValueError, UnicodeError, RecursionError):
        raise Refused("invalid_json") from None


@contextlib.contextmanager
def directory(path):
    """Pin every component with O_NOFOLLOW, including the fixed roots."""
    path = Path(path)
    if not path.is_absolute() or ".." in path.parts:
        raise Refused("invalid_folder")
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in path.parts[1:]:
            child = os.open(
                part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=fd
            )
            os.close(fd)
            fd = child
        yield fd
    finally:
        os.close(fd)


def folder(role, value):
    roots = {"work": fence.WORK_ROOT, "run": fence.RUN_ROOT}
    if role not in roots:
        raise Refused("invalid_role")
    parts = value.split("/") if isinstance(value, str) else [value]
    if len(parts) > (3 if role == "run" else 2):
        raise Refused("invalid_folder")
    path = roots[role].joinpath(*(identifier(part) for part in parts))
    with directory(path):
        pass
    return path


def protected_read(path, mode):
    with directory(path.parent) as parent:
        fd = os.open(
            path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=parent
        )
    with os.fdopen(fd) as stream:
        info = os.fstat(stream.fileno())
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != mode
        ):
            raise Refused("unsafe_configuration")
        return stream.read()


def load_configuration():
    profiles = decode_json(protected_read(CONFIG / "profiles.json", 0o644))
    if type(profiles) is not dict or set(profiles) != {*LAYOUTS, "task"}:
        raise Refused("invalid_configuration")
    for name, layout in LAYOUTS.items():
        # The builders own the machinery; metadata cannot silently widen their contract.
        if profiles[name] != {"image": fence.IMAGE, "limits": LIMITS, **layout}:
            raise Refused("invalid_configuration")
    if profiles["task"] != TASK_PROFILE:
        raise Refused("invalid_configuration")
    callers = decode_json(protected_read(CONFIG / "callers.json", 0o644))
    if type(callers) is not dict:
        raise Refused("invalid_configuration")
    for uid, allowed in callers.items():
        if (
            not re.fullmatch(r"0|[1-9][0-9]*", uid)
            or int(uid) > 2**32 - 1
            or type(allowed) is not list
            or not allowed
            or any(type(p) is not str or p not in profiles for p in allowed)
            or len(set(allowed)) != len(allowed)
        ):
            raise Refused("invalid_configuration")
    return profiles, callers


def approved_image(tag):
    approved = protected_read(CONFIG / "images", 0o600).splitlines()
    if not approved or any(not IMAGE_ID.fullmatch(line) for line in approved):
        raise Refused("invalid_images")
    result = subprocess.run(
        ["docker", "image", "inspect", "--format", "{{.Id}}", tag],
        capture_output=True,
        check=True,
        timeout=30,
    )
    image = result.stdout.decode("ascii").strip()
    if image not in approved:
        raise Refused("image_not_approved")
    return image


def usage_arguments(image):
    credentials = fence.real_directory(fence.LOGIN_ROOT / "codex")
    info = credentials.stat()
    if stat.S_IMODE(info.st_mode) != 0o700 or info.st_uid != fence.UID or info.st_gid != fence.GID:
        raise Refused("invalid_login")
    return [
        *fence.sealed_arguments("none"),
        "--mount",
        f"type=bind,src={credentials},dst=/login,readonly",
        "--workdir",
        "/home/agent",
        "--env",
        "HOME=/home/agent",
        image,
        *USAGE_COMMAND,
    ]


def bounded_task_string(value, reason):
    try:
        if type(value) is str and "\x00" not in value:
            size = len(value.encode("utf-8"))
            if size <= TASK_STRING_LIMIT:
                return size
    except UnicodeError:
        pass
    raise Refused(reason)


def task_arguments(request):
    shape = request.get("shape")
    if type(shape) is not str or shape not in TASK_SHAPES:
        raise Refused("unknown_shape")
    layout = TASK_SHAPES[shape]
    if shape == "clone":
        arguments = clone_arguments(request)
        clone_environment(request)
    else:
        fields(
            request,
            ("op", "profile", "run_id", "work_id", "shape", "env", "arguments"),
            ("workspace",) if shape == "data" else (),
        )
        environment = request["env"]
        allowed = {name for name in layout["environment"] if "=" not in name}
        if type(environment) is not dict or environment.keys() != allowed:
            raise Refused("invalid_environment")
        size = sum(
            bounded_task_string(value, "invalid_environment") for value in environment.values()
        )
        arguments = request["arguments"]
        if type(arguments) is not list or not 1 <= len(arguments) <= TASK_ARGUMENT_LIMIT:
            raise Refused("invalid_arguments")
        size += sum(bounded_task_string(value, "invalid_arguments") for value in arguments)
        if size > TASK_DATA_LIMIT:
            raise Refused("task_data_too_large")
    name = "homelab-launcher-task-" + identifier(request["run_id"])
    workspace = request.get("workspace", "task")
    if workspace not in ("task", "cli"):
        raise Refused("invalid_role")
    if workspace == "cli" and not CLI_WORK.fullmatch(request["work_id"]):
        raise Refused("invalid_identifier")
    root = TASK_WORK_ROOT if workspace == "task" else fence.WORK_ROOT
    work = root / identifier(request["work_id"])
    with directory(work) as fd:
        info = os.fstat(fd)
        uid, gid = info.st_uid, info.st_gid
    if uid in (0, 21020):
        raise Refused("invalid_owner")
    if shape not in ("clone", "data"):
        with directory(work / ".git"):
            pass
    if "venv" in layout["mounts"]:
        with directory(work / ".venv"):
            pass
    args = [
        "docker",
        "run",
        "--rm",
        "--name",
        name,
        "--pull",
        "never",
        "--init",
        "--user",
        f"{uid}:{gid}",
        "--cap-drop",
        "ALL",
        "--security-opt",
        "no-new-privileges",
        "--read-only",
        "--tmpfs",
        TASK_PROFILE["tmpfs"][0],
        "--tmpfs",
        TASK_PROFILE["tmpfs"][1].replace("<uid>", str(uid)).replace("<gid>", str(gid)),
        "--memory",
        "8g",
        "--memory-swap",
        "8g",
        "--cpus",
        "2",
        "--pids-limit",
        "512",
        "--log-driver",
        "none",
        "--network",
        layout["network"],
        "--workdir",
        "/work",
    ]
    sources = {"work": work, "git": work / ".git", "venv": work / ".venv"}
    for role, mount in layout["mounts"].items():
        destination, mode = mount.split(":")
        args += [
            "--mount",
            f"type=bind,src={sources[role]},dst={destination}"
            + (",readonly" if mode == "ro" else ""),
        ]
    if layout["stdin"]:
        args.append("--interactive")
    for variable in layout["environment"]:
        args += ["--env", variable]
    if shape == "clone" and "env" in request:
        for variable in layout["optional_environment"]:
            args += ["--env", variable]
    if layout["entrypoint"]:
        args += ["--entrypoint", layout["entrypoint"]]
    # Caller data only follows the immutable image and fixed entry. It can never
    # supply a Docker option, bind source, network, image or host command.
    return [*args, approved_image(TASK_IMAGE), *layout["entry"], *arguments], name


def clone_environment(request):
    if "env" not in request:
        return {}
    environment = request["env"]
    if type(environment) is not dict or set(environment) != {"GIT_CONFIG_VALUE_0"}:
        raise Refused("invalid_environment")
    value = environment["GIT_CONFIG_VALUE_0"]
    if (
        type(value) is not str
        or len(value) > 8192
        or not re.fullmatch(r"Authorization: Basic [A-Za-z0-9+/]+=*", value)
    ):
        raise Refused("invalid_environment")
    return environment


CLI_INPUT_BYTES = 4 * 1024 * 1024


def cli_input(descriptor):
    """Snapshot a regular descriptor; contract-sized content never enters argv or records."""
    info = os.fstat(descriptor)
    if not stat.S_ISREG(info.st_mode):
        raise Refused("invalid_stdin")
    if info.st_size > CLI_INPUT_BYTES:
        raise Refused("stdin_too_large")
    source = os.pread(descriptor, CLI_INPUT_BYTES + 1, 0)
    if len(source) > CLI_INPUT_BYTES:
        raise Refused("stdin_too_large")
    try:
        document = decode_json(source)
        fields(document, ("goal", "assets"), ("work",))
        goal, assets = document["goal"], document["assets"]
        if (
            type(goal) is not str
            or not 1 <= len(goal) <= 200_000
            or "\x00" in goal
            or type(assets) is not list
            or len(assets) > 32
        ):
            raise ValueError
        encoded = json.dumps(assets, ensure_ascii=False, allow_nan=False)
        if len(encoded.encode("utf-8")) > 200_000:
            raise ValueError
        work = document.get("work")
        if work is not None:
            if type(work) is not dict:
                raise ValueError
            goal += "\n\nRun work policy (JSON):\n" + json.dumps(
                work, ensure_ascii=False, allow_nan=False
            )
        if assets:
            goal += "\n\nSupplied assets (JSON):\n" + encoded
        return goal.encode("utf-8")
    except (Refused, ValueError, TypeError, KeyError, UnicodeError, RecursionError):
        raise Refused("invalid_stdin") from None


def run_arguments(request, profiles):
    profile = request.get("profile")
    if type(profile) is not str or profile not in profiles:
        raise Refused("unknown_profile")
    if profile == "task":
        return task_arguments(request)
    common = ("op", "profile", "run_id")
    if profile in ("cli-run", "chat"):
        fields(
            request,
            (
                *common,
                "folders",
                "tool",
                "command",
                "exports",
                *(("turn",) if profile == "chat" else ()),
            ),
            ("read_only", "stdin") if profile == "cli-run" else (),
        )
        if profile == "cli-run" and type(request.get("read_only", False)) is not bool:
            raise Refused("invalid_read_only")
        if profile == "cli-run" and type(request.get("stdin", False)) is not bool:
            raise Refused("invalid_stdin")
        if type(request["tool"]) is not str or request["tool"] not in fence.TOOLS:
            raise Refused("invalid_tool")
        command = request["command"]
        if (
            type(command) is not list
            or not command
            or any(type(arg) is not str or "\x00" in arg for arg in command)
        ):
            raise Refused("invalid_command")
        exports = request["exports"]
        if type(exports) is not list:
            raise Refused("invalid_exports")
        for export in exports:
            identifier(export)
        if len(set(exports)) != len(exports):
            raise Refused("invalid_exports")
        if profile == "chat" and (
            type(request["turn"]) is not int or not 1 <= request["turn"] <= 2**63 - 1
        ):
            raise Refused("invalid_turn")
    elif profile == "bundle":
        fields(request, (*common, "folders", "branch"), ("stream",))
        if type(request.get("stream", False)) is not bool:
            raise Refused("invalid_stream")
        if type(request["branch"]) is not str:
            raise Refused("invalid_branch")
    else:
        fields(request, common)
    run_id = identifier(request["run_id"])
    name = (
        f"factory-session-turn-{request['turn']}"
        if profile == "chat"
        else f"homelab-fence-run-{run_id}"
    )
    if profile != "usage":
        fields(request["folders"], ("work", "run"))
        work = folder("work", request["folders"]["work"])
        run = folder("run", request["folders"]["run"])
    if profile in ("cli-run", "chat"):
        paths = [work / "repos" / export for export in exports]
        for path in paths:
            with directory(path):
                pass
        args = fence.docker_arguments(
            request["tool"],
            repo=work,
            run=run,
            command=command,
            read_only_paths=paths,
            container_name=name if profile == "chat" else None,
        )
        if request.get("read_only", False):
            mount = f"type=bind,src={work},dst=/work"
            args[args.index(mount)] = mount + ",readonly"
        if request.get("stdin", False):
            args.insert(args.index(fence.IMAGE), "--interactive")
    elif profile == "bundle":
        args = fence.bundle_arguments(repo=work, run=run, branch=request["branch"])
        if request.get("stream", False):
            args[args.index("/run/factory/branch.bundle")] = "-"
    else:
        args = usage_arguments(fence.IMAGE)
    # Resolve the tag immediately before launch and run the approved immutable id.
    image_index = args.index(fence.IMAGE)
    args[image_index] = approved_image(profiles[profile]["image"])
    if profile != "chat":
        args[image_index:image_index] = ["--name", name]
    return args, name


def own(path):
    """Use fwalk's pinned directories and never dereference a leaf symlink."""
    with directory(path) as top:
        for _, dirs, files, fd in os.fwalk(".", dir_fd=top, follow_symlinks=False):
            for name in dirs + files:
                os.chown(name, fence.UID, fence.GID, dir_fd=fd, follow_symlinks=False)
        os.fchown(top, fence.UID, fence.GID)


def remove(path):
    # shutil's fd-based implementation is resistant to symlink substitution races.
    if not shutil.rmtree.avoids_symlink_attacks:
        raise Refused("unsafe_platform")
    with directory(path.parent) as parent:
        with directory(path):
            shutil.rmtree(path.name, dir_fd=parent)


def receive(connection, descriptors):
    data = bytearray()
    while b"\n" not in data:
        chunk, received, flags, _ = socket.recv_fds(
            connection, MAX_LINE + 1 - len(data), 3, socket.MSG_CMSG_CLOEXEC
        )
        descriptors.extend(received)
        if flags & (socket.MSG_CTRUNC | socket.MSG_TRUNC) or len(descriptors) > 3:
            raise Refused("invalid_descriptors")
        if not chunk:
            raise Refused("incomplete_request")
        data.extend(chunk)
        if len(data) > MAX_LINE:
            raise Refused("line_too_long")
    if data[-1:] != b"\n" or data.count(b"\n") != 1:
        raise Refused("invalid_frame")
    return decode_json(data)


def peer_uid(connection):
    return struct.unpack(
        "iII", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("iII"))
    )[1]


class Launcher:
    def __init__(self, profiles, callers, state=STATE):
        self.profiles, self.callers, self.state = profiles, callers, state
        self.lock = threading.Lock()
        self.active = set()
        self.active_work = set()
        self.context = threading.local()

    def authorize(self, uid, profile):
        if str(uid) not in self.callers:
            raise Refused("unknown_uid")
        if profile not in self.callers[str(uid)]:
            raise Refused("profile_denied")

    def record_path(self, run_id):
        return self.state / (identifier(run_id) + ".json")

    def read_record(self, uid, run_id):
        try:
            record = decode_json(protected_read(self.record_path(run_id), 0o600))
        except FileNotFoundError:
            raise Refused("unknown_run") from None
        self.authorize(uid, record["profile"])
        if uid != 0 and uid != record["uid"]:
            raise Refused("run_denied")
        return record

    @staticmethod
    def write_data(path, data, exclusive=False):
        if exclusive:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
            with os.fdopen(fd, "w") as stream:
                stream.write(data)
        else:
            temp = path.with_suffix(path.suffix + ".tmp")
            fd = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
            try:
                with os.fdopen(fd, "w") as stream:
                    stream.write(data)
                os.replace(temp, path)
            finally:
                temp.unlink(missing_ok=True)

    def write_record(self, run_id, record, exclusive=False):
        self.write_data(self.record_path(run_id), json.dumps(record), exclusive)
        # Names (especially chat turn numbers) can be reused. An old run id must
        # never authorize status/stop against a later run with the same name.
        self.write_data(self.state / (record["name"] + ".current"), run_id)

    def is_current(self, run_id, record):
        try:
            return protected_read(self.state / (record["name"] + ".current"), 0o600) == run_id
        except FileNotFoundError:
            return False

    def docker(self, *args):
        return subprocess.run(
            ["docker", *args], stdin=subprocess.DEVNULL, capture_output=True, check=True, timeout=30
        )

    def container_exists(self, name):
        return bool(
            self.docker("ps", "-aq", "--filter", f"name=^/{re.escape(name)}$").stdout.strip()
        )

    def execute(self, uid, request, descriptors):
        # A caller cannot use a second task container (or remove/recreate) to swap
        # a bind source between validation and Docker's mount. Fence clients keep
        # their existing concurrency outside the task-attempt namespace.
        key = None
        if isinstance(request, dict):
            operation = request.get("op")
            profile = request.get("profile")
            if operation == "run" and profile == "task":
                self.authorize(uid, "task")
                workspace = request.get("workspace", "task")
                if workspace not in ("task", "cli"):
                    raise Refused("invalid_role")
                key = workspace, identifier(request.get("work_id"))
            elif operation in ("task-create", "task-remove", "cli-create", "cli-remove"):
                self.authorize(uid, "task")
                key = (
                    ("cli" if operation.startswith("cli-") else "task"),
                    identifier(request.get("work_id")),
                )
            elif operation == "run" and profile in ("cli-run", "bundle"):
                folders = request.get("folders")
                work = folders.get("work") if isinstance(folders, dict) else None
                if isinstance(work, str) and CLI_WORK.fullmatch(work):
                    self.authorize(uid, profile)
                    key = "cli", work
            elif operation in ("own", "remove") and request.get("role") in ("work", "run"):
                folder_id = request.get("folder_id")
                if isinstance(folder_id, str) and CLI_WORK.fullmatch(folder_id):
                    key = "cli", folder_id
        if key is None:
            return self._execute(uid, request, descriptors)
        with self.lock:
            if key in self.active_work:
                raise Refused("work_active")
            self.active_work.add(key)
        try:
            return self._execute(uid, request, descriptors)
        finally:
            with self.lock:
                self.active_work.discard(key)

    def _execute(self, uid, request, descriptors):
        if str(uid) not in self.callers:
            raise Refused("unknown_uid")
        if type(request) is not dict or type(request.get("op")) is not str:
            raise Refused("invalid_fields")
        operation = request["op"]
        if operation == "run":
            task_stdin = request.get("profile") == "task" and request.get("shape") in (
                "agent",
                "review",
                "data",
            )
            cli_stdin = request.get("profile") == "cli-run" and request.get("stdin") is True
            has_stdin = task_stdin or cli_stdin
            if len(descriptors) != 2 + has_stdin:
                raise Refused("invalid_descriptors")
            for fd in descriptors[:2]:
                if fcntl.fcntl(fd, fcntl.F_GETFL) & os.O_ACCMODE == os.O_RDONLY:
                    raise Refused("invalid_descriptors")
            if has_stdin and (
                fcntl.fcntl(descriptors[2], fcntl.F_GETFL) & os.O_ACCMODE == os.O_WRONLY
            ):
                raise Refused("invalid_descriptors")
            profile = request.get("profile")
            if type(profile) is not str or profile not in self.profiles:
                raise Refused("unknown_profile")
            self.authorize(uid, profile)
            if profile == "task" and request.get("workspace") == "cli":
                self.authorize(uid, "cli-run")
            self.context.profile = profile
            payload = cli_input(descriptors[2]) if cli_stdin else None
            args, name = run_arguments(request, self.profiles)
            run_id = request["run_id"]
            record = {"profile": profile, "name": name, "uid": uid, "exit_code": None}
            with self.lock:
                if name in self.active or self.container_exists(name):
                    raise Refused("run_exists")
                try:
                    self.write_record(run_id, record, exclusive=True)
                except FileExistsError:
                    raise Refused("run_exists") from None
                self.active.add(name)
            code = 125
            task_environment = (
                {"PATH": os.defpath, **request.get("env", {})} if profile == "task" else None
            )
            try:
                try:
                    with contextlib.ExitStack() as resources:
                        source = descriptors[2] if task_stdin else subprocess.DEVNULL
                        if cli_stdin:
                            source = resources.enter_context(
                                os.fdopen(
                                    os.memfd_create("homelab-cli-input", os.MFD_CLOEXEC), "w+b"
                                )
                            )
                            source.write(payload)
                            source.seek(0)
                        code = subprocess.run(
                            args,
                            stdin=source,
                            stdout=descriptors[0],
                            stderr=descriptors[1],
                            check=False,
                            timeout=self.profiles[profile]["timeout"],
                            **({"env": task_environment} if profile == "task" else {}),
                        ).returncode
                except subprocess.TimeoutExpired:
                    code = 124
                finally:
                    # Task/chat cleanup also covers a failed or interrupted Docker client.
                    if profile in ("chat", "task") or CLI_WORK.fullmatch(
                        request.get("folders", {}).get("work", "")
                    ):
                        try:
                            if self.container_exists(name):
                                self.docker("rm", "-f", name)
                        except (OSError, subprocess.SubprocessError):
                            code = 125
            finally:
                with self.lock:
                    record["exit_code"] = code
                    try:
                        self.write_record(run_id, record)
                    finally:
                        self.active.discard(name)
            return {"ok": True, "exit_code": code}
        if descriptors:
            raise Refused("invalid_descriptors")
        if operation == "task-image":
            self.authorize(uid, "task")
            fields(request, ("op",))
            return {"ok": True, "image": approved_image(TASK_IMAGE)}
        if operation == "ping":
            fields(request, ("op",))
            return {"ok": True}
        if operation in ("task-create", "task-remove", "cli-create", "cli-remove"):
            self.authorize(uid, "task")
            fields(request, ("op", "work_id"))
            work_id = identifier(request["work_id"])
            if operation.startswith("cli-"):
                self.authorize(uid, "cli-run")
                if not CLI_WORK.fullmatch(work_id):
                    raise Refused("invalid_identifier")
                roots, owner = (fence.WORK_ROOT, fence.RUN_ROOT), (fence.UID, fence.GID)
            else:
                account = pwd.getpwnam("homelab-task")
                roots, owner = (TASK_WORK_ROOT,), (account.pw_uid, account.pw_gid)
            if owner[0] in (0, 21020):
                raise Refused("invalid_owner")
            with self.lock:
                if operation.endswith("create"):
                    # Reject collisions before creating either Factory folder.
                    for root in roots:
                        with directory(root) as parent:
                            try:
                                os.stat(work_id, dir_fd=parent, follow_symlinks=False)
                            except FileNotFoundError:
                                continue
                            raise FileExistsError(work_id)
                for root in roots:
                    with directory(root) as parent:
                        info = os.fstat(parent)
                        if info.st_uid != 0 or (info.st_mode & 0o022 and not info.st_mode & 0o1000):
                            raise Refused("unsafe_work_root")
                        if operation.endswith("create"):
                            os.mkdir(
                                work_id, 0o755 if root == TASK_WORK_ROOT else 0o700, dir_fd=parent
                            )
                            with directory(root / work_id) as child:
                                os.fchown(child, *owner)
                                # The host unit uses UMask=0077; runs needs read traversal.
                                os.fchmod(child, 0o755 if root == TASK_WORK_ROOT else 0o700)
                        else:
                            try:
                                remove(root / work_id)
                            except FileNotFoundError:
                                pass
            return {"ok": True}
        if operation == "task-recover":
            self.authorize(uid, "task")
            fields(request, ("op",))
            # Only this caller's persisted launch records authorize cleanup. Factory is separate.
            for path in self.state.glob("*.json"):
                record = self.read_record(uid, path.stem) if uid == 0 else None
                if record is None:
                    raw = decode_json(protected_read(path, 0o600))
                    if raw["uid"] != uid:
                        continue
                    record = self.read_record(uid, path.stem)
                if record["profile"] in ("task", "cli-run", "bundle", "usage") and self.is_current(
                    path.stem, record
                ):
                    if self.container_exists(record["name"]):
                        self.docker("rm", "-f", record["name"])
            return {"ok": True}
        if operation in ("own", "remove"):
            fields(request, ("op", "role", "folder_id"))
            if type(request["role"]) is not str:
                raise Refused("invalid_role")
            path = folder(request["role"], request["folder_id"])
            (own if operation == "own" else remove)(path)
            return {"ok": True}
        if operation in ("status", "stop"):
            fields(request, ("op", "run_id"))
            with self.lock:
                record = self.read_record(uid, request["run_id"])
            name = record["name"]
            self.context.profile = record["profile"]
            if operation == "stop":
                # docker run can still be creating the container. Never acknowledge a
                # successful stop while that launch can subsequently start unnoticed.
                deadline = time.monotonic() + 30
                while True:
                    with self.lock:
                        if not self.is_current(request["run_id"], record):
                            break
                        exists = self.container_exists(name)
                        active = name in self.active
                        if exists:
                            self.docker("rm", "-f", name)
                            break
                        if not active:
                            break
                    if time.monotonic() >= deadline:
                        raise Refused("stop_failed")
                    time.sleep(0.1)
                return {"ok": True}
            with self.lock:
                record = self.read_record(uid, request["run_id"])
                exists = self.is_current(request["run_id"], record) and self.container_exists(name)
            return {"ok": True, "running": exists, "exit_code": record["exit_code"]}
        raise Refused("unknown_operation")

    def handle(self, connection):
        descriptors = []
        request = None
        uid = -1
        self.context.profile = None
        try:
            uid = peer_uid(connection)
            connection.settimeout(30)
            request = receive(connection, descriptors)
            response = self.execute(uid, request, descriptors)
        except Refused as exc:
            response = {"ok": False, "error": str(exc)}
        except (OSError, ValueError, subprocess.SubprocessError):
            response = {"ok": False, "error": "unavailable"}
        except Exception:
            # No traceback or exception text: it may contain a command or file data.
            response = {"ok": False, "error": "internal_error"}
        finally:
            for fd in descriptors:
                os.close(fd)
        audit = {
            "uid": uid,
            "reason": response.get("error", "completed"),
            "exit_code": response.get("exit_code"),
        }
        if self.context.profile is not None:
            audit["profile"] = self.context.profile
        if type(request) is dict:
            if request.get("op") in ("own", "remove", "run", "status", "stop"):
                audit["op"] = request["op"]
            if type(request.get("profile")) is str and request["profile"] in self.profiles:
                audit["profile"] = request["profile"]
            if request.get("role") in ("work", "run"):
                audit["role"] = request["role"]
            for key in ("run_id", "folder_id"):
                value = request.get(key)
                if type(value) is str and IDENTIFIER.fullmatch(value):
                    audit[key] = value
        logger.info("%s", json.dumps(audit, separators=(",", ":")))
        try:
            connection.sendall((json.dumps(response, separators=(",", ":")) + "\n").encode())
        except OSError:
            pass


def main():
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    try:
        if (
            os.getuid() != 0
            or os.environ.get("LISTEN_PID") != str(os.getpid())
            or os.environ.get("LISTEN_FDS") != "1"
        ):
            raise Refused("socket_activation_required")
        profiles, callers = load_configuration()
        # RuntimeDirectory= creates this root-only directory; never use a work root.
        info = STATE.lstat()
        if (
            not stat.S_ISDIR(info.st_mode)
            or info.st_uid != 0
            or info.st_gid != 0
            or stat.S_IMODE(info.st_mode) != 0o700
        ):
            raise Refused("unsafe_state")
        launcher = Launcher(profiles, callers)
        with socket.socket(fileno=3) as listener:
            if listener.family != socket.AF_UNIX or listener.type != socket.SOCK_STREAM:
                raise Refused("invalid_socket")
            # Bound the number of connections and threads, while keeping stop/status live.
            with concurrent.futures.ThreadPoolExecutor(max_workers=32) as workers:
                slots = threading.BoundedSemaphore(32)
                while True:
                    slots.acquire()
                    connection, _ = listener.accept()

                    def serve(connection=connection):
                        try:
                            with connection:
                                launcher.handle(connection)
                        finally:
                            slots.release()

                    workers.submit(serve)
    except (Refused, OSError, ValueError):
        logger.error("launcher_unavailable")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
