#!/usr/bin/env python3
"""Restore a dump in an isolated container and compare tables and counts."""
import datetime
import json
from pathlib import Path
import signal
import subprocess
import sys
import time
import uuid

DIRECTORY = Path('/srv/homelab/homelab-v2-data/originals/postgres')
DUMP = '/usr/local/sbin/homelab-dump'
LIVE = 'homelab-postgres-1'
IMAGE = 'pgvector/pgvector:pg17'
FAILURE = 'homelab-restore-check: failed'
TABLES = "SELECT coalesce(json_agg(json_build_array(schemaname, tablename) ORDER BY schemaname, tablename), '[]'::json) FROM pg_catalog.pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema') AND schemaname NOT LIKE 'pg_toast%'"


def run(args, **kwargs):
    return subprocess.run(args, check=True, stderr=subprocess.DEVNULL, **kwargs)


def query(container, sql):
    result = run(['docker', 'exec', container, 'psql', '-X', '-qAt', '-v', 'ON_ERROR_STOP=1',
                  '-U', 'homelab', '-d', 'homelab', '-c', sql], stdout=subprocess.PIPE)
    return result.stdout.decode().strip()


def identifier(value):
    return '"' + value.replace('"', '""') + '"'


def check(path):
    name = 'homelab-restore-check-' + uuid.uuid4().hex
    def interrupted(signum, frame):
        raise InterruptedError()
    previous = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGTERM, signal.SIGHUP)}
    try:
        run(['docker', 'run', '-d', '--name', name, '--network', 'none',
             '-e', 'POSTGRES_HOST_AUTH_METHOD=trust', '-e', 'POSTGRES_USER=homelab',
             '-e', 'POSTGRES_DB=homelab', IMAGE], stdout=subprocess.DEVNULL)
        deadline = time.monotonic() + 60
        while True:
            ready = subprocess.run(['docker', 'exec', name, 'pg_isready', '-U', 'homelab',
                                    '-d', 'homelab'], stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL, timeout=max(0.1, deadline - time.monotonic()))
            if ready.returncode == 0:
                break
            if time.monotonic() >= deadline:
                raise TimeoutError()
            time.sleep(min(1, max(0, deadline - time.monotonic())))
        with path.open('rb') as dump:
            run(['docker', 'exec', '-i', name, 'pg_restore', '--exit-on-error', '--no-owner',
                 '-U', 'homelab', '-d', 'homelab'], stdin=dump, stdout=subprocess.DEVNULL)
        live_tables = json.loads(query(LIVE, TABLES))
        restored_tables = json.loads(query(name, TABLES))
        if live_tables != restored_tables:
            missing = sorted(set(map(tuple, live_tables)) ^ set(map(tuple, restored_tables)))[0]
            print('table differs: ' + '.'.join(json.dumps(part) for part in missing))
            return 1
        for schema, table in live_tables:
            sql = 'SELECT count(*) FROM ' + identifier(schema) + '.' + identifier(table)
            live, restored = int(query(LIVE, sql)), int(query(name, sql))
            if live != restored:
                print('count differs: ' + '.'.join(json.dumps(part) for part in (schema, table)) +
                      f' live={live} restored={restored}')
                return 1
        print('ok')
        return 0
    finally:
        # Ignore further termination signals until Docker has removed the container.
        for sig in previous:
            signal.signal(sig, signal.SIG_IGN)
        subprocess.run(['docker', 'rm', '-f', name], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)
        for sig, handler in previous.items():
            signal.signal(sig, handler)


def main():
    try:
        if len(sys.argv) > 2:
            raise ValueError()
        if len(sys.argv) == 2:
            path = Path(sys.argv[1])
        else:
            run([DUMP], stdout=subprocess.DEVNULL)
            path = DIRECTORY / ('homelab-' + datetime.date.today().isoformat() + '.dump')
        return check(path)
    except (OSError, ValueError, subprocess.SubprocessError):
        print(FAILURE, file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
