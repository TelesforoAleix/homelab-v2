#!/usr/bin/env python3
"""Stream encrypted originals; acknowledge only a checked destination copy."""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

ROOT = Path("/srv/homelab")
RECIPIENT = Path("/etc/homelab-copy.recipient")
STATE = Path("/var/lib/homelab-copy/last-good.json")
NOTIFY = "/usr/local/sbin/homelab-notify.sh"


def stream(output, report):
    if not os.path.ismount(ROOT):
        raise ValueError("data volume is locked")
    folders = sorted(ROOT.glob("*-data/originals"))
    if not folders:
        raise ValueError("no originals folders")
    manifest = []
    for folder in folders:
        if not folder.is_dir() or folder.resolve() != folder:
            raise ValueError("originals must be real directories on the data volume")
        size = subprocess.check_output(["du", "-sk", str(folder)], text=True).split()[0]
        manifest.append({"folder": str(folder.relative_to(ROOT)), "bytes": int(size) * 1024})
    tar = subprocess.Popen(
        [
            "tar",
            "-C",
            str(ROOT),
            "-cp",
            "--numeric-owner",
            "-f",
            "-",
            "--",
            *[item["folder"] for item in manifest],
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    age = None
    try:
        age = subprocess.Popen(
            ["age", "-R", str(RECIPIENT)],
            stdin=tar.stdout,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
        tar.stdout.close()
        count = 0
        while chunk := age.stdout.read(1024 * 1024):
            output.write(chunk)
            count += len(chunk)
        output.flush()
        age_status = age.wait()
        tar_status = tar.wait()
        if age_status or tar_status:
            raise ValueError("tar or age failed; do not confirm this copy")
        print(json.dumps({"manifest": manifest, "bytes": count}), file=report, flush=True)
    finally:
        for process in (age, tar):
            if process is not None:
                if process.poll() is None:
                    process.terminate()
                process.wait()


def confirm(count):
    if count <= 0:
        raise ValueError("bytes must be positive")
    STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    temporary = STATE.with_name(f".last-good-{os.getpid()}")
    try:
        with temporary.open("x") as handle:
            os.chmod(temporary, 0o600)
            json.dump({"timestamp": int(time.time()), "bytes": count}, handle)
            handle.flush()
            os.fsync(handle.fileno())
        temporary.replace(STATE)
    finally:
        temporary.unlink(missing_ok=True)


def status(remind=False):
    record = json.loads(STATE.read_text()) if STATE.exists() else None
    seconds = time.time() - record["timestamp"] if record else None
    if remind:
        if seconds is None or seconds > 7 * 86400:
            days = str(int(seconds // 86400)) if seconds is not None else "unknown (no copy yet)"
            subprocess.run(
                [
                    NOTIFY,
                    f"weekly copy is {days} days old; plug the SD card into the Mac and send /backup",
                ],
                check=True,
            )
    else:
        print(json.dumps(record))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("stream")
    commands.add_parser("confirm").add_argument("bytes", type=int)
    commands.add_parser("status").add_argument("--remind", action="store_true")
    args = parser.parse_args()
    try:
        if args.command == "stream":
            stream(sys.stdout.buffer, sys.stderr)
        elif args.command == "confirm":
            confirm(args.bytes)
        else:
            status(args.remind)
    except (OSError, ValueError, subprocess.SubprocessError):
        print("homelab-copy: operation failed; no successful copy recorded", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
