# Home Lab watchdog: one recovery notice per boot.
# Installed to /etc/systemd/system/homelab-watchdog.service.
#
# The timer runs homelab-watchdog.sh to report the previous stop's cleanliness,
# downtime and data volume lock state through homelab-notify.sh.
#
# Reusing homelab-bot allows reading the existing root:homelab-bot 0640
# allowlist without a new account grant. Both services send to the same chats
# with the same token; a new account would reproduce that access.
#
# AF_UNIX is excluded to prevent access to the model helper socket, even
# though the bot group has filesystem permission to connect to it.
# systemctl also needs AF_UNIX, so the script probes findmnt alone instead.
# The unlock procedure mounts before starting homelab-data.target.
#
# SupplementaryGroups=systemd-journal grants the running unit access to the
# previous boot's journal without widening homelab-bot's account-wide groups.
# Verify security against the running unit, not just this file.

[Unit]
Description=Home Lab watchdog -- once-per-boot recovery notice
Documentation=https://github.com/TelesforoAleix/homelab-v2
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

# No dependency on the volume, probe or bot: the watcher must survive
# the things it watches. Its own failures use the shared notifier.
OnFailure=homelab-notify@watchdog.service

[Service]
Type=oneshot
User=homelab-bot
Group=homelab-bot
SupplementaryGroups=systemd-journal

ExecStart=/usr/local/sbin/homelab-watchdog.sh

# --- The token -------------------------------------------------------------
# PID 1 supplies a private credential copy before the process starts.
# The script needs no read permission on the root-owned source token.
LoadCredential=bot-token:/etc/homelab-telegram-bot/token

# --- Restart policy ----------------------------------------------------
# A clean exit stays stopped; failed sends use the bounded restart policy.
Restart=on-failure
RestartSec=10

# --- Privilege ---------------------------------------------------------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

# --- Filesystem ----------------------------------------------------------
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ReadOnlyPaths=/etc/homelab-telegram-bot

# --- Kernel and system ---------------------------------------------------
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

# --- Network -------------------------------------------------------------
# Outbound HTTPS only; excluding AF_UNIX blocks the model helper socket.
RestrictAddressFamilies=AF_INET AF_INET6

# --- System calls --------------------------------------------------------
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @swap @reboot @raw-io @debug @module @cpu-emulation
