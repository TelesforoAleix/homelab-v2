[Unit]
Description=Both encrypted volumes mounted and Docker ready
ConditionPathIsMountPoint=/srv/homelab
ConditionPathIsMountPoint=/srv/homelab-bulk
Requires=srv-homelab.mount srv-homelab\x2dbulk.mount docker.service containerd.service
After=srv-homelab.mount srv-homelab\x2dbulk.mount docker.service containerd.service
# No [Install]: the unlock script starts this, never boot.
