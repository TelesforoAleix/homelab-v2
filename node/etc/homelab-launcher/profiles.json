{
  "cli-run": {
    "image": "homelab-fence:1",
    "limits": {
      "memory": "4g",
      "memory_swap": "4g",
      "cpus": "2",
      "pids": 256
    },
    "network": "homelab-fence",
    "mounts": {
      "login": "/login:rw",
      "work": "/work:rw",
      "run": "/run/factory:rw",
      "exports": "/work/repos/<id>:ro"
    },
    "timeout": null,
    "optional": {
      "read_only": false,
      "stdin": false
    }
  },
  "chat": {
    "image": "homelab-fence:1",
    "limits": {
      "memory": "4g",
      "memory_swap": "4g",
      "cpus": "2",
      "pids": 256
    },
    "network": "homelab-fence",
    "mounts": {
      "login": "/login:rw",
      "work": "/work:rw",
      "run": "/run/factory:rw",
      "exports": "/work/repos/<id>:ro"
    },
    "timeout": 1200
  },
  "bundle": {
    "image": "homelab-fence:1",
    "limits": {
      "memory": "4g",
      "memory_swap": "4g",
      "cpus": "2",
      "pids": 256
    },
    "network": "none",
    "mounts": {
      "work": "/work:ro",
      "run": "/run/factory:rw"
    },
    "timeout": null,
    "optional": {
      "stream": false
    }
  },
  "usage": {
    "image": "homelab-fence:1",
    "limits": {
      "memory": "4g",
      "memory_swap": "4g",
      "cpus": "2",
      "pids": 256
    },
    "network": "none",
    "mounts": {
      "codex-login": "/login:ro"
    },
    "timeout": null
  },
  "task": {
    "image": "homelab-task:2",
    "limits": {
      "memory": "8g",
      "memory_swap": "8g",
      "cpus": "2",
      "pids": 512
    },
    "user": "work-owner (non-root)",
    "tmpfs": [
      "/tmp:rw,exec,nosuid,nodev,size=4g,mode=1777",
      "/home/task:rw,exec,nosuid,nodev,size=4g,uid=<uid>,gid=<gid>,mode=0700"
    ],
    "shapes": {
      "prepare": {
        "network": "homelab-packages",
        "mounts": {
          "work": "/work:rw",
          "git": "/work/.git:ro"
        },
        "stdin": false,
        "environment": [
          "HTTPS_PROXY=http://package-proxy:8888",
          "UV_HTTP_TIMEOUT=120",
          "HOMELAB_PI_VERSION"
        ],
        "entrypoint": null,
        "entry": [
          "sh",
          "-c"
        ]
      },
      "agent": {
        "network": "homelab-tasks",
        "mounts": {
          "work": "/work:rw",
          "git": "/work/.git:ro",
          "venv": "/work/.venv:ro"
        },
        "stdin": true,
        "environment": [
          "HOMELAB_TASK_TOKEN",
          "HOMELAB_TASK_PURPOSE",
          "HOMELAB_PI_MODELS",
          "HOMELAB_PI_SETTINGS"
        ],
        "entrypoint": null,
        "entry": [
          "sh",
          "-c"
        ]
      },
      "review": {
        "network": "homelab-tasks",
        "mounts": {
          "work": "/work:ro"
        },
        "stdin": true,
        "environment": [
          "HOMELAB_TASK_TOKEN",
          "HOMELAB_TASK_PURPOSE",
          "HOMELAB_PI_MODELS",
          "HOMELAB_PI_SETTINGS"
        ],
        "entrypoint": null,
        "entry": [
          "sh",
          "-c"
        ]
      },
      "check": {
        "network": "none",
        "mounts": {
          "work": "/work:rw",
          "git": "/work/.git:ro",
          "venv": "/work/.venv:ro"
        },
        "stdin": false,
        "environment": [
          "UV_NO_SYNC",
          "PYTHONPYCACHEPREFIX"
        ],
        "entrypoint": null,
        "entry": [
          "sh",
          "-c"
        ]
      },
      "commit": {
        "network": "none",
        "mounts": {
          "work": "/work:rw",
          "venv": "/work/.venv:ro"
        },
        "stdin": false,
        "environment": [
          "PATH=/usr/bin:/bin",
          "GIT_AUTHOR_NAME",
          "GIT_AUTHOR_EMAIL"
        ],
        "entrypoint": "/usr/bin/python3",
        "entry": [
          "-I",
          "-c"
        ]
      },
      "clone": {
        "network": "homelab-fence",
        "mounts": {
          "work": "/work:rw"
        },
        "stdin": false,
        "environment": [
          "HTTPS_PROXY=http://cli-proxy:8888",
          "HTTP_PROXY=http://cli-proxy:8888",
          "GIT_CONFIG_NOSYSTEM=1",
          "GIT_CONFIG_GLOBAL=/dev/null",
          "GIT_TERMINAL_PROMPT=0"
        ],
        "entrypoint": "/usr/bin/git",
        "entry": [],
        "optional_environment": [
          "GIT_CONFIG_COUNT=1",
          "GIT_CONFIG_KEY_0=http.https://github.com/.extraHeader",
          "GIT_CONFIG_VALUE_0"
        ]
      },
      "data": {
        "network": "none",
        "mounts": {
          "work": "/work:rw"
        },
        "stdin": true,
        "environment": [],
        "entrypoint": "/usr/bin/python3",
        "entry": [
          "-I",
          "-c"
        ]
      }
    },
    "timeout": null
  }
}
