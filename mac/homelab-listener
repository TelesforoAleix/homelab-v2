#!/usr/bin/env python3
"""Owner's launchd agent: one fixed action over the node-only Tailscale channel."""

import argparse
import ipaddress
import json
import os
import plistlib
import re
import runpy
import signal
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

PORT = 8091
COPY_TIMEOUT = 180
LABEL = "org.homelab.listener"
SCRIPT = Path(__file__).resolve()
STATE = Path.home() / ".local/state/homelab-listener"
PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
CARD = Path("/Volumes/SD Card")
REPORT = re.compile(
    r"/Volumes/SD Card/(homelab-originals-\d{4}-\d{2}-\d{2}\.tar\.age): "
    r"([1-9]\d*) encrypted bytes; confirmed on node"
)


def check_address(value):
    address = ipaddress.IPv4Address(value.strip())
    if address not in ipaddress.IPv4Network((0x64400000, 10)):
        raise ValueError("Tailscale IPv4 required")
    return str(address)


def tailscale_address():
    # Reuse the vision CLI/utun discovery, including refusal of ambiguous addresses.
    return runpy.run_path(str(SCRIPT.with_name("homelab-vision")))["tailscale_address"]()


class Actions:
    def __init__(self):
        self.lock = threading.Lock()
        self.stopping = threading.Event()
        self.process = None

    def dispatch(self, path):
        if path != "/backup":
            return 404, {"status": "unknown"}
        if not self.lock.acquire(blocking=False):
            return 409, {"status": "busy"}
        try:
            return 200, self.backup()
        finally:
            self.lock.release()

    def backup(self):
        if not os.path.ismount(CARD):
            return {"status": "no-card"}
        if self.stopping.is_set():
            return {"status": "failed", "reason": "copy stopped"}
        try:
            self.process = subprocess.Popen(
                [sys.executable, str(SCRIPT.with_name("homelab-copy")), "SD Card"],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                start_new_session=True,
            )
            if self.stopping.is_set():
                self.kill_copy()
            try:
                output, _ = self.process.communicate(timeout=COPY_TIMEOUT)
            except subprocess.TimeoutExpired:
                self.kill_copy()
                self.process.communicate()
                return {"status": "failed", "reason": "copy timed out"}
            if self.process.returncode:
                return {"status": "failed", "reason": "check card and SSH; existing copies remain"}
            lines = output.decode("utf-8").splitlines()
            match = REPORT.fullmatch(lines[-1]) if lines else None
            if not match:
                return {"status": "failed", "reason": "invalid copy report"}
            return {"status": "done", "file": match[1], "bytes": int(match[2])}
        except (OSError, UnicodeError, ValueError):
            return {"status": "failed", "reason": "could not run copy"}
        finally:
            self.kill_copy()
            if self.process is not None:
                self.process.wait()
            self.process = None

    def kill_copy(self):
        process = self.process
        if process is not None and process.poll() is None:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def stop(self):
        self.stopping.set()
        self.kill_copy()


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(10)

    def log_message(self, *args):
        pass  # Default access/error logs contain arbitrary request content.

    def respond(self, code, reply):
        data = json.dumps(reply).encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Connection", "close")
        self.end_headers()
        self.close_connection = True
        try:
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass

    def do_POST(self):
        # No arguments, body, query parameters, paths or commands are accepted.
        if self.headers.get("Transfer-Encoding") or self.headers.get("Content-Length", "0") != "0":
            self.respond(404, {"status": "unknown"})
            return
        code, reply = self.server.actions.dispatch(self.path)
        if reply["status"] != "unknown":
            print(
                f"action=backup result={reply['status']} bytes={reply.get('bytes', 0)}", flush=True
            )
        self.respond(code, reply)

    def do_GET(self):
        self.respond(404, {"status": "unknown"})

    do_HEAD = do_GET
    do_PUT = do_GET
    do_DELETE = do_GET
    do_PATCH = do_GET
    do_OPTIONS = do_GET
    do_TRACE = do_GET
    do_CONNECT = do_GET


class Server(ThreadingHTTPServer):
    daemon_threads = False

    def handle_error(self, request, client_address):
        print("listener request failed", flush=True)


def make_server(address):
    # Validate at the binding boundary even if discovery is replaced or misconfigured.
    address = check_address(address)
    server = Server((address, PORT), Handler)
    server.actions = Actions()
    return server


def serve():
    server = make_server(tailscale_address())

    def stop(signum, frame):
        server.actions.stop()
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, stop)
    try:
        print("listener serving on Tailscale port 8091", flush=True)
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.actions.stop()
        server.server_close()


def launchctl(*args, check=True):
    return subprocess.run(["/bin/launchctl", *args], check=check, capture_output=True)


def agent(command):
    domain = f"gui/{os.getuid()}"
    service = f"{domain}/{LABEL}"
    if command == "install":
        if PLIST.exists():
            raise ValueError("agent already installed; uninstall before reinstalling")
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        PLIST.parent.mkdir(parents=True, exist_ok=True)
        settings = {
            "Label": LABEL,
            "ProgramArguments": [sys.executable, str(SCRIPT), "serve"],
            "WorkingDirectory": str(SCRIPT.parent.parent),
            "EnvironmentVariables": {
                "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
                "PYTHONUNBUFFERED": "1",
                "PYTHONDONTWRITEBYTECODE": "1",
            },
            "RunAtLoad": True,
            "KeepAlive": True,
            "ThrottleInterval": 10,
            "Umask": 0o077,
            "StandardOutPath": str(STATE / "listener.log"),
            "StandardErrorPath": str(STATE / "listener.log"),
        }
        with PLIST.open("xb") as handle:
            os.chmod(PLIST, 0o600)
            plistlib.dump(settings, handle)
        launchctl("enable", service)
        launchctl("bootstrap", domain, str(PLIST))
        print("listener installed; check status and private listener.log")
    elif command == "uninstall":
        result = launchctl("bootout", service, check=False)
        if result.returncode and launchctl("print", service, check=False).returncode == 0:
            raise ValueError("agent could not be unloaded; plist retained")
        PLIST.unlink(missing_ok=True)
        print("listener uninstalled; private logs retained")
    elif command == "stop":
        launchctl("bootout", service)
        print("listener stopped until start or next login")
    elif command == "start":
        launchctl("enable", service)
        launchctl("bootstrap", domain, str(PLIST))
        print("listener started; check status and private listener.log")
    else:
        result = launchctl("print", service, check=False)
        running = result.returncode == 0 and b"state = running" in result.stdout
        print("listener running" if running else "listener not running")
        return 0 if running else 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command", choices=["install", "uninstall", "start", "stop", "status", "serve"]
    )
    args = parser.parse_args()
    os.umask(0o077)
    try:
        if args.command == "serve":
            serve()
            return 0
        return agent(args.command)
    except (OSError, ValueError, subprocess.SubprocessError):
        parser.exit(1, "listener operation failed; check Tailscale and private listener.log\n")


if __name__ == "__main__":
    raise SystemExit(main())
