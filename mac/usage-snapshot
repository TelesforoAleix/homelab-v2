#!/usr/bin/env python3
"""Save Claude Code's rate-limit fields from status-line JSON on stdin, discarding the rest.

Runs inside the owner's status line: it never prints and always exits 0, so it cannot disturb
that line. Input without both windows leaves the previous snapshot in place.
"""

import json
import math
import sys
from datetime import datetime, timezone
from pathlib import Path


def window(row):
    used = row.get("used_percentage") if isinstance(row, dict) else None
    if type(used) not in (int, float) or not math.isfinite(used):
        return None
    reset = row.get("resets_at")
    return {
        "used_percentage": used,
        "resets_at": reset if type(reset) in (int, float, str) else None,
    }


def main():
    try:
        limits = json.load(sys.stdin).get("rate_limits")
        five, seven = window(limits.get("five_hour")), window(limits.get("seven_day"))
    except (AttributeError, ValueError):
        return 0
    if not five or not seven:
        return 0
    snapshot = {
        "as_of": datetime.now(timezone.utc).isoformat(),  # noqa: UP017 - status lines may run Python 3.9
        "five_hour": five,
        "seven_day": seven,
    }
    destination = Path.home() / ".local/state/homelab-usage/claude.json"
    try:
        destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        temp = destination.with_suffix(".tmp")
        temp.touch(mode=0o600)
        temp.chmod(0o600)
        temp.write_text(json.dumps(snapshot) + "\n")
        temp.replace(destination)
    except OSError:
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
