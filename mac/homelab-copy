#!/usr/bin/env python3
"""Copy encrypted node originals directly onto a mounted external volume."""

import argparse
import datetime
import json
import os
import plistlib
import subprocess
import sys
from pathlib import Path

SSH = ["ssh", "homelab-agent", "sudo", "homelab-copy"]


def volume_path(value):
    path = Path(value if value.startswith("/") else "/Volumes/" + value)
    if path.is_symlink() or path.resolve().parent != Path("/Volumes"):
        raise ValueError("target must be a mounted volume directly under /Volumes")
    path = path.resolve()
    if not os.path.ismount(path):
        raise ValueError("target is not mounted")
    info = plistlib.loads(subprocess.check_output(["diskutil", "info", "-plist", str(path)]))
    if info.get("Internal") is not False or info.get("MountPoint") != str(path):
        raise ValueError("target must be external, not the startup disk")
    return path


def copy(volume):
    destination = volume / f"homelab-originals-{datetime.date.today().isoformat()}.tar.age"
    # Exclusive creation also prevents following an existing symlink.
    with destination.open("xb") as handle:
        process = subprocess.Popen([*SSH, "stream"], stdout=handle, stderr=subprocess.PIPE)
        try:
            _, report = process.communicate()
            handle.flush()
            os.fsync(handle.fileno())
            if process.returncode:
                raise ValueError("stream failed; partial file remains on the card, not confirmed")
            # SSH may emit connection warnings; the final line must be the completion report.
            result = json.loads(report.decode().splitlines()[-1])
            size = os.fstat(handle.fileno()).st_size
            if type(result["bytes"]) is not int or size <= 0 or size != result["bytes"]:
                raise ValueError("size mismatch; copy not confirmed")
        finally:
            if process.poll() is None:
                process.terminate()
                process.wait()
    subprocess.run([*SSH, "confirm", str(size)], check=True)
    for item in result["manifest"]:
        print(f"{item['folder']}: {item['bytes']} bytes")
    print(f"{destination}: {size} encrypted bytes; confirmed on node")
    return destination


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("volume", help="volume name or /Volumes/<NAME>")
    args = parser.parse_args()
    try:
        copy(volume_path(args.volume))
    except (OSError, ValueError, KeyError, IndexError, subprocess.SubprocessError):
        print(
            "homelab-copy: failed; check the mounted external volume and SSH connection; "
            "an existing or partial copy is never overwritten",
            file=sys.stderr,
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
