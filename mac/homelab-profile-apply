#!/usr/bin/python3 -I
"""Root-owned, isolated interpreter; only bounded numeric system settings are accepted."""

import json
import os
import pwd
import stat
import subprocess
import sys

DEFAULTS = {
    "working": {},
    "inference": {"powermode": 2, "sleep": 0, "gpu_limit_mb": 45056},
}
BOUNDS = {"powermode": (0, 2), "sleep": (0, 180), "gpu_limit_mb": (0, 45056)}


def read_private(path, uid):
    # Neither profile configuration nor recorded recovery state is trusted root code.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd) as handle:
        info = os.fstat(handle.fileno())
        if info.st_uid != uid or not stat.S_ISREG(info.st_mode) or info.st_size > 65536:
            raise ValueError("invalid private file")
        value = json.loads(handle.read(65537))
    if not isinstance(value, dict):
        raise ValueError("invalid private file")
    return value


def run(argv, capture=False):
    return subprocess.run(
        argv,
        check=True,
        stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env={"PATH": "/usr/bin:/bin:/usr/sbin:/sbin"},
        timeout=30,
        text=True,
    )


def validate(values):
    if set(values) - set(BOUNDS):
        raise ValueError("invalid settings")
    for key, value in values.items():
        low, high = BOUNDS[key]
        if type(value) is not int or not low <= value <= high:
            raise ValueError("setting outside approved bounds")


def apply(profile):
    if profile not in DEFAULTS or os.geteuid() != 0:
        raise ValueError("invalid invocation")
    uid = int(os.environ["SUDO_UID"])
    home = pwd.getpwuid(uid).pw_dir
    path = home + "/.config/homelab/profiles.json"
    values = DEFAULTS[profile].copy()
    config = read_private(path, uid)
    if not isinstance(config.get("profiles", {}), dict):
        raise ValueError("invalid configuration")
    entry = config.get("profiles", {}).get(profile, {})
    if not isinstance(entry, dict) or not isinstance(entry.get("settings", {}), dict):
        raise ValueError("invalid settings")
    values.update(entry.get("settings", {}))
    # Check legacy Working settings, then ignore them: Working owns no defaults.
    if profile == "inference" and (
        values.get("powermode") != 2 or type(values["powermode"]) is not int
    ):
        raise ValueError("Inference requires High Power")
    validate(values)
    try:
        record = read_private(home + "/.local/state/homelab-profile/session.json", uid)
    except FileNotFoundError:
        record = {}
    if record.get("return_pending") is True:
        previous = {key: record.get("previous_" + key) for key in BOUNDS}
        validate(previous)
        if profile == "working":
            values = previous
    elif profile == "inference":
        # The unprivileged command captures recovery before any switching side effect.
        raise ValueError("Inference requires recorded AC settings and GPU limit")
    else:
        # No pending return: leave both power sources alone, clear an orphan GPU limit.
        current = run(["/usr/sbin/sysctl", "-n", "iogpu.wired_limit_mb"], capture=True).stdout
        if int(current.strip()) != 0:
            run(["/usr/sbin/sysctl", "-w", "iogpu.wired_limit_mb=0"])
        return
    if profile == "inference":
        source = run(["/usr/bin/pmset", "-g", "batt"], capture=True).stdout
        if not source.startswith("Now drawing from 'AC Power'"):
            raise ValueError("Inference requires AC power")
    # No shell, user executable, environment lookup, arbitrary sysctl or extra flags.
    if "powermode" in values:
        run(["/usr/bin/pmset", "-c", "powermode", str(values["powermode"])])
    for argv in (
        ["/usr/bin/pmset", "-c", "sleep", str(values["sleep"])],
        ["/usr/sbin/sysctl", "-w", "iogpu.wired_limit_mb=" + str(values["gpu_limit_mb"])],
    ):
        run(argv)


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("one profile required")
        apply(sys.argv[1])
    except (OSError, ValueError, KeyError, subprocess.SubprocessError):
        sys.exit("profile settings refused or failed")
