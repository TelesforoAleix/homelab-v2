# Copy to .env (git-ignored). Compose reads it for the values below.
HOMELAB_DB_PASSWORD=change-me

# Where things live on the node. Defaults are the encrypted volume; on a laptop point them at
# a local directory (Brain: a clone of the brain repository).
HOMELAB_CORPUS_PATH=/srv/homelab/homelab-v2-data/originals/corpus
HOMELAB_BRAIN_PATH=/srv/homelab/brain
HOMELAB_BRAIN_INCLUDE=01-knowledge,02-ideas,05-logs
HOMELAB_POSTGRES_PATH=/srv/homelab/postgres
HOMELAB_MODELS_PATH=/srv/homelab/models

# Application log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).
HOMELAB_LOG_LEVEL=INFO

# Model clients know only this URL and a client key (accepted and ignored for now).
# The URL is Docker DNS; on a Docker host, use the api container for the CLI.
HOMELAB_MODELS_BASE_URL=http://litellm:4000/v1
HOMELAB_MODELS_API_KEY=homelab

# The embedding model llama-server loads (Hugging Face repo:quant). Changing it means reindexing.
# HOMELAB_EMBED_MODEL=mradermacher/llama-nemotron-embed-1b-v2-GGUF:Q8_0

# Private Mac Tailscale URL on port 8090, ending in /v1. Empty disables local vision.
HOMELAB_MAC_VISION_URL=
